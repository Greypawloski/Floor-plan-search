# Copy this file to .env and fill in your values

# URL to monitor
FLOOR_PLAN_URL=https://7600broadway.com/floorplans/

# How often to check (minutes)
CHECK_INTERVAL_MINUTES=5

# SMTP email settings
# iCloud: SMTP_HOST=smtp.mail.me.com  SMTP_USER=you@mac.com  SMTP_PORT=587
# Gmail:  SMTP_HOST=smtp.gmail.com    SMTP_USER=you@gmail.com  SMTP_PORT=587
#         (Gmail requires an App Password — myaccount.google.com/apppasswords)
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
SMTP_USER=your_apple_id@mac.com
SMTP_PASS=your-app-specific-password

# Where to send notifications (can be same as SMTP_USER)
NOTIFY_EMAIL=your_email@mac.com

# Comma-separated list of floor plan names to watch.
# Leave blank (or remove) to watch ALL plans.
# Names are matched case-insensitively as substrings, so "B10" matches "Plan B10",
# "PH1" matches "Penthouse 1", etc.
WATCH_PLANS=B10,Penthouse 1,Penthouse 2
