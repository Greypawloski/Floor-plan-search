# Copy this file to .env and fill in your values

# URL to monitor
FLOOR_PLAN_URL=https://7600broadway.com/floorplans/

# How often to check (minutes)
CHECK_INTERVAL_MINUTES=5

# Email settings — Gmail example (use an App Password, not your account password)
# To create a Gmail App Password: myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# Where to send notifications (can be same as SMTP_USER)
NOTIFY_EMAIL=your_email@gmail.com

# Comma-separated list of floor plan names to watch.
# Leave blank (or remove) to watch ALL plans.
# Names are matched case-insensitively as substrings, so "B10" matches "Plan B10",
# "PH1" matches "Penthouse 1", etc.
WATCH_PLANS=B10,Penthouse 1,Penthouse 2
